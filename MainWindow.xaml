<Window x:Class="ClipDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDeck" Width="420" Height="640" MinWidth="340" MinHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
        PreviewMouseLeftButtonDown="Window_PreviewMouseDown">
    <Border CornerRadius="16" Background="#1C1C21" BorderBrush="#2E2E37" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Margin="2,0,0,8">
                <TextBlock Text="ClipDeck" Foreground="#ECECF1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Ghost}" Content="✕" HorizontalAlignment="Right" Click="Hide_Click" ToolTip="Скрыть (программа остаётся в трее)"/>
            </Grid>

            <!-- tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="TabClips" Style="{StaticResource Tab}" Content="Буфер" IsChecked="True" Click="Tab_Click"/>
                <RadioButton x:Name="TabScripts" Style="{StaticResource Tab}" Content="Скрипты" Click="Tab_Click"/>
                <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}" Content="Настройки" Click="Tab_Click"/>
            </StackPanel>

            <!-- ============ CLIPBOARD ============ -->
            <Grid x:Name="ClipsPanel" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,8" TextChanged="Search_TextChanged" ToolTip="Поиск по истории"/>
                <ListBox x:Name="ClipList" Grid.Row="1" PreviewMouseLeftButtonUp="ClipList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" Foreground="#ECECF1"/>
                                    <TextBlock Text="{Binding TimeText}" Foreground="#7F7F8E" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <Button Style="{StaticResource Ghost}" Content="{Binding PinGlyph}" Click="Pin_Click" ToolTip="Закрепить"/>
                                    <Button Style="{StaticResource Ghost}" Content="✕" Click="DeleteClip_Click" ToolTip="Удалить"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel x:Name="ClipOptions">
                        <CheckBox Content="Enter после вставки" IsChecked="{Binding AutoSend, Mode=TwoWay}" ToolTip="Сразу отправлять, например в чат"/>
                        <CheckBox Content="Печатать, а не вставлять" IsChecked="{Binding TypeInstead, Mode=TwoWay}" ToolTip="Для полей, куда нельзя вставить Ctrl+V"/>
                        <CheckBox Content="Скрывать после вставки" IsChecked="{Binding HideAfter, Mode=TwoWay}"/>
                        <CheckBox Content="Пауза записи" IsChecked="{Binding Paused, Mode=TwoWay}"/>
                    </WrapPanel>
                    <Button Content="Очистить историю (кроме закреплённых)" Click="ClearClips_Click" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============ SCRIPTS ============ -->
            <Grid x:Name="ScriptsPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="+ Новый" Click="NewScript_Click" Margin="0,0,6,0"/>
                    <Button Content="Удалить" Click="DeleteScript_Click" Margin="0,0,6,0"/>
                    <Button Content="▶ Запустить" Click="RunScript_Click" Margin="0,0,6,0"/>
                    <Button Content="■ Стоп" Click="StopScript_Click"/>
                </WrapPanel>
                <ListBox x:Name="ScriptList" Grid.Row="1" MaxHeight="120" Margin="0,0,0,6" SelectionChanged="ScriptList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#ECECF1" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding HotkeyText}" Foreground="#7F7F8E" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="Editor" Grid.Row="2" IsEnabled="False" LostKeyboardFocus="Editor_LostFocus">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название скрипта"/>
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Горячая клавиша (нажмите в поле)" Foreground="#9A9AA8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Tag="script" IsReadOnly="True" Text="{Binding Hotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Повторов (0 — пока не остановите)" Foreground="#9A9AA8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Repeat, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Text="Пауза между шагами, мс" Foreground="#9A9AA8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StepDelayMs, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <ListBox x:Name="StepList" Grid.Row="2" ItemsSource="{Binding Steps}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{Binding TypeTitle}" Click="StepType_Click" ToolTip="Нажмите, чтобы сменить тип шага" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource Ghost}" Content="↑" Click="StepUp_Click"/>
                                        <Button Style="{StaticResource Ghost}" Content="↓" Click="StepDown_Click"/>
                                        <Button Style="{StaticResource Ghost}" Content="✕" Click="StepDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                        <Button Content="+ Клавиша" Click="AddKeyStep_Click" Margin="0,0,6,0"/>
                        <Button Content="+ Текст" Click="AddTextStep_Click" Margin="0,0,6,0"/>
                        <Button Content="+ Пауза" Click="AddWaitStep_Click"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#7F7F8E" FontSize="11"
                               Text="Клавиша: T, Enter, F5, /, Ctrl+V, Shift+Tab. Текст: что напечатать. Пауза: миллисекунды."/>
                </Grid>
            </Grid>

            <!-- ============ SETTINGS ============ -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsStack" Margin="0,0,6,0">
                    <TextBlock Text="Показать / скрыть окно (нажмите в поле)" Foreground="#9A9AA8" Margin="0,0,0,4"/>
                    <TextBox Tag="overlay" IsReadOnly="True" Text="{Binding OverlayHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,10"/>
                    <TextBlock Text="Остановить скрипт (нажмите в поле)" Foreground="#9A9AA8" Margin="0,0,0,4"/>
                    <TextBox Tag="stop" IsReadOnly="True" Text="{Binding StopHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,10"/>
                    <TextBlock x:Name="HotkeyInfo" Foreground="#E58A8A" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <CheckBox Content="Всегда поверх остальных окон" IsChecked="{Binding Topmost, Mode=TwoWay}"/>
                    <TextBlock Text="Прозрачность окна" Foreground="#9A9AA8" Margin="0,8,0,2"/>
                    <Slider Minimum="0.4" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" Margin="0,0,0,8"/>
                    <CheckBox Content="Режим сканкодов (для игр)" IsChecked="{Binding ScanMode, Mode=TwoWay}"/>
                    <CheckBox Content="Сохранять всю историю на диск" IsChecked="{Binding SaveHistory, Mode=TwoWay}"/>
                    <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows" Click="AutoStart_Click"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Длительность нажатия клавиши, мс" Foreground="#9A9AA8" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding HoldMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Максимум записей в истории" Foreground="#9A9AA8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxItems, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#7F7F8E" FontSize="11"
                               Text="Окно открывается поверх игр в режиме «в окне без рамки». В настоящем полноэкранном режиме Windows может его скрыть. Чтобы вводить текст в программы, запущенные от администратора, запустите ClipDeck тоже от администратора. Пароли из менеджеров паролей в историю не попадают. Автонажатие клавиш в онлайн-играх с античитом (Vanguard, EasyAntiCheat и др.) может привести к блокировке аккаунта, используйте скрипты там на свой риск."/>
                    <Button Content="Выйти из ClipDeck" Click="Exit_Click" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" Foreground="#7F7F8E" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
